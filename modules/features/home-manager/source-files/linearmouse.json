{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.12.0",
  "schemes" : [
    {
      "buttons" : {
        "mappings" : [
          {
            "outcomes" : {
              "press" : {
                "action" : "mouse.button.left",
                "behavior" : "remap"
              }
            },
            "trigger" : {
              "input" : {
                "button" : 0
              },
              "modifiers" : [
                "control"
              ]
            }
          },
          {
            "action" : "mouse.wheel.scrollDown",
            "trigger" : {
              "input" : {
                "wheel" : "down"
              },
              "modifiers" : [
                "shift"
              ]
            }
          },
          {
            "action" : "mouse.wheel.scrollUp",
            "trigger" : {
              "input" : {
                "wheel" : "up"
              },
              "modifiers" : [
                "shift"
              ]
            }
          }
        ],
        "universalBackForward" : true
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc548",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "logitech" : {
        "highResolutionWheel" : true
      },
      "pointer" : {
        "acceleration" : 0.1015,
        "disableAcceleration" : true,
        "hardwareDPI" : 8000
      },
      "scrolling" : {
        "acceleration" : 1,
        "distance" : 4,
        "reverse" : true,
        "smoothed" : {
          "enabled" : false
        },
        "speed" : 0
      }
    }
  ]
}
